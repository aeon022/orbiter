{
  "name": "orbiter-codemirror-md-build",
  "private": true,
  "description": "Builds packages/admin/public/vendor/codemirror-md.js (CodeMirror 6 + Vim) for the editor's Markdown / HTML source view. Run: npm install && npm run build",
  "scripts": { "build": "esbuild entry.js --bundle --minify --format=iife --global-name=OrbCM --target=es2020 --legal-comments=none --outfile=../../packages/admin/public/vendor/codemirror-md.js" },
  "dependencies": {
    "@codemirror/commands": "6.11.1", "@codemirror/lang-html": "6.4.12", "@codemirror/lang-markdown": "6.5.2", "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6", "@codemirror/view": "6.43.15", "@lezer/highlight": "1.2.5", "@replit/codemirror-vim": "6.4.0", "esbuild": "0.28.2"
  }
}
