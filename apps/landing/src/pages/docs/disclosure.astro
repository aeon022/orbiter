import DocsLayout from '../../layouts/DocsLayout.astro';
const advisories = [
  ['GHSA-wv82-8593-g3c5', 'Stored XSS in the inbox', 'admin 0.3.82', 'Adrian Wilczek'],
  ['GHSA-w3h3-6g4r-hxc5', 'Collection permission bypass (singletons and export)', 'admin 0.3.82', 'Adrian Wilczek'],
  ['GHSA-r4r2-gxr8-p3vc', 'Media path traversal', 'core 0.3.15', 'Adrian Wilczek'],
