<script is:inline>
  // Reveal observer — handles all animated elements
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale, .rm-item').forEach(el => observer.observe(el));

  // Remove page curtain + clear planet animation after intro
  const curtain = document.querySelector('.page-curtain');
  if (curtain) setTimeout(() => curtain.remove(), 2000);

  // Scroll parallax
  const planetScene = document.getElementById('planet-scene');
  // Clear CSS animation so JS can control transform/opacity
  if (planetScene) {
    planetScene.addEventListener('animationend', () => {
      planetScene.style.animation = 'none';
    });
  }
  const lightBeam = document.getElementById('light-beam');
  const lightBeamGlow = document.getElementById('light-beam-glow');
  const nav = document.querySelector('.vision-nav');
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        const vh = window.innerHeight;

        // Nav appears after hero
        if (nav) nav.classList.toggle('visible', scrollY > vh * 0.6);

        // Planet sinks and fades — smooth parallax
        if (planetScene) {
          const progress = Math.min(scrollY / (vh * 1.5), 1);
          const translateY = progress * vh * 0.6;
          const scale = 1 - progress * 0.12;
          const finalOpacity = Math.max(1 - progress * 1.5, 0);
          planetScene.style.transform = `translateY(${translateY}px) scale(${scale})`;
          planetScene.style.opacity = finalOpacity;
          planetScene.style.visibility = finalOpacity <= 0 ? 'hidden' : 'visible';
        }

        // Vertical light beam grows from top
        if (lightBeam) {
          const beamStart = vh * 0.4;
          const beamScroll = Math.max(scrollY - beamStart, 0);
          const beamProgress = Math.min(beamScroll / (vh * 3), 1);
          const beamHeight = beamProgress * vh * 2.5;
          const beamOpacity = Math.min(beamProgress * 1.2, 0.5);
          lightBeam.style.height = beamHeight + 'px';
          lightBeam.style.opacity = beamOpacity;
          lightBeamGlow.style.height = beamHeight * 0.5 + 'px';
          lightBeamGlow.style.opacity = beamOpacity * 0.3;
        }

        // Roadmap scan glow + energy line
        const track = document.getElementById('roadmap-track');
        const glow = document.getElementById('roadmap-glow');
        const energy = document.getElementById('track-energy');
        if (track && glow) {
          const trackRect = track.getBoundingClientRect();
          const trackTop = trackRect.top;
          const trackH = trackRect.height;

          if (trackTop < vh && trackTop + trackH > 0) {
            glow.classList.add('active');
            const scanPos = Math.max(0, Math.min(vh * 0.45 - trackTop, trackH - 200));
            glow.style.top = scanPos + 'px';

            if (energy) {
              const energyH = Math.max(0, Math.min(scanPos + 100, trackH));
              energy.style.height = energyH + 'px';
            }
          } else {
            glow.classList.remove('active');
          }
        }

        ticking = false;
      });
      ticking = true;
    }
  });


  // ── Roadmap: filter, anchors, progress, pointer glow (progressive enhancement: without JS everything is shown) ──
  (function () {
    const items = [...document.querySelectorAll('.rm-item')];
    const controls = document.getElementById('rm-controls');
    if (!items.length || !controls) return;
    const kindOf = (el) => el.querySelector('.rm-dot.done') ? 'shipped' : 'coming';
    const slug = (t) => t.toLowerCase().replace(/&amp;|&/g, ' ').replace(/<[^>]+>/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const used = new Set();
    items.forEach((el) => {
      el.dataset.kind = kindOf(el);
      const title = el.querySelector('.rm-title');
      let id = slug(title.textContent); while (used.has(id)) id += '-2'; used.add(id);
      el.id = id;
      const a = document.createElement('a'); a.className = 'rm-anchor'; a.href = '#' + id; a.textContent = '#'; a.setAttribute('aria-label', 'Link to ' + title.textContent);
      title.appendChild(a);
    });
    // Items that are still ahead get a "weigh in" link: a pre-filled GitHub issue, so a vote is a comment, not a form on our side
    items.filter((el) => el.dataset.kind !== 'shipped').forEach((el) => {
      const t = el.querySelector('.rm-title').textContent.replace(/#$/, '').trim();
      const a = document.createElement('a'); a.className = 'rm-weigh'; a.target = '_blank'; a.rel = 'noopener';
      a.href = 'https://github.com/aeon022/orbiter/issues/new?labels=roadmap&title=' + encodeURIComponent('Roadmap: ' + t) + '&body=' + encodeURIComponent('I would use this because…\n\nMy setup / use case:\n');
      a.innerHTML = 'Weigh in on GitHub <span aria-hidden="true">↗</span>'; a.setAttribute('aria-label', 'Weigh in on GitHub: ' + t + ' (opens a new issue)');
      el.querySelector('.rm-tag')?.after(a);
    });
    const count = { shipped: items.filter(i => i.dataset.kind === 'shipped').length };
    count.coming = items.length - count.shipped; count.all = items.length;
    controls.hidden = false;
    controls.querySelectorAll('.rm-chip[data-filter]').forEach(c => { c.querySelector('.n').textContent = count[c.dataset.filter]; });
    document.getElementById('rm-progress-label').textContent = count.shipped + ' of ' + count.all + ' roadmap items shipped';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fill = document.getElementById('rm-progress-fill');
    const setFill = () => { fill.style.width = Math.round(count.shipped / count.all * 100) + '%'; };
    reduce ? setFill() : new IntersectionObserver((e, o) => { if (e[0].isIntersecting) { setFill(); o.disconnect(); } }, { threshold: .5 }).observe(controls);

    function apply(filter, keepHash) {
      controls.querySelectorAll('.rm-chip[data-filter]').forEach(c => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
      items.forEach((el) => {
        const show = filter === 'all' || el.dataset.kind === filter;
        el.hidden = !show; if (show) el.classList.add('visible');
      });
      if (!keepHash) history.replaceState(null, '', filter === 'coming' ? location.pathname : '#' + filter);
    }
    controls.addEventListener('click', (e) => { const c = e.target.closest('.rm-chip[data-filter]'); if (c) apply(c.dataset.filter); });

    // Deep links: #shipped / #all / #<item-id> (switches to the filter that contains the item)
    function fromHash() {
      const h = decodeURIComponent(location.hash.slice(1));
      if (h === 'shipped' || h === 'all') return apply(h, true);
      const target = h && document.getElementById(h);
      if (target && target.classList.contains('rm-item')) {
        apply(target.dataset.kind === 'shipped' ? 'shipped' : 'coming', true);
        requestAnimationFrame(() => target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }));
      } else apply('coming', true);
    }
    window.addEventListener('hashchange', fromHash); fromHash();

    // Machine view: the same roadmap as structured data (what an agent would consume)
    const dlg = document.getElementById('mv-dialog');
    if (dlg && typeof dlg.showModal === 'function') {
      const txt = (el) => (el ? el.textContent.replace(/\s+/g, ' ').replace(/#$/, '').trim() : '');
      const build = () => JSON.stringify({
        '@type': 'Roadmap', name: 'Orbiter roadmap', url: location.origin + location.pathname,
        note: 'Same content as this page, as structured data. See also /llms.txt and /feed.json.',
        summary: { shipped: count.shipped, comingUp: count.coming, total: count.all },
        items: items.map((el) => ({
          id: el.id, status: el.dataset.kind === 'shipped' ? 'shipped' : (el.querySelector('.rm-dot.next') ? 'next' : 'planned'),
          phase: txt(el.querySelector('.rm-phase')), title: txt(el.querySelector('.rm-title')), summary: txt(el.querySelector('.rm-desc')),
          links: [...el.querySelectorAll('.rm-desc a')].map((a) => new URL(a.getAttribute('href'), location.href).href),
        })),
      }, null, 2);
      const pre = document.getElementById('mv-pre');
      document.getElementById('rm-machine-btn').addEventListener('click', () => { pre.textContent = build(); dlg.showModal(); pre.scrollTop = 0; });
      document.getElementById('mv-close').addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      document.getElementById('mv-copy').addEventListener('click', async (e) => {
        try { await navigator.clipboard.writeText(pre.textContent); e.target.textContent = 'Copied ✓'; setTimeout(() => { e.target.textContent = 'Copy JSON'; }, 1600); } catch { e.target.textContent = 'Copy failed'; }
      });
    } else { const b = document.getElementById('rm-machine-btn'); if (b) b.hidden = true; }

    // Horizon cards jump to their roadmap item
    document.querySelectorAll('.hz-card').forEach((c) => c.addEventListener('click', (e) => {
      const t = document.getElementById(c.dataset.target); if (!t) return;
      e.preventDefault(); apply('coming', true); history.replaceState(null, '', '#' + c.dataset.target);
      t.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    }));

    // Soft glow that follows the pointer (fine pointers only)
    if (matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce) {
      document.querySelectorAll('.hz-card').forEach((c) => c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect(); c.style.setProperty('--mx', (e.clientX - r.left) + 'px'); c.style.setProperty('--my', (e.clientY - r.top) + 'px');
      }));
    }
  })();

  // ── Canvas Starfield ──
  const canvas = document.getElementById('starfield');
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0, stars = [];

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  function initStars(n) {
    stars = Array.from({ length: n || 180 }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      r: Math.random() * 1.3 + 0.2,
      vx: (Math.random() - 0.5) * 0.1,
      vy: (Math.random() - 0.5) * 0.1,
      base: Math.random() * 0.5 + 0.1,
      phase: Math.random() * Math.PI * 2,
      speed: Math.random() * 0.015 + 0.003,
    }));
  }
  function drawStars() {
    ctx.clearRect(0, 0, W, H);
    for (const s of stars) {
      s.phase += s.speed;
      const a = s.base + Math.sin(s.phase) * 0.2;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(210,215,255,' + a + ')';
      ctx.fill();
      s.x += s.vx;
      s.y += s.vy;
      if (s.x < -2) s.x = W + 2;
      if (s.x > W + 2) s.x = -2;
      if (s.y < -2) s.y = H + 2;
      if (s.y > H + 2) s.y = -2;
    }
    requestAnimationFrame(drawStars);
  }
  resize();
  initStars();
  drawStars();
  window.addEventListener('resize', () => { resize(); initStars(); });

  // Back to top
  const btt = document.getElementById('btt');
  const warpJump = document.getElementById('warp-jump');
  if (btt) {
    window.addEventListener('scroll', () => {
      btt.classList.toggle('visible', window.scrollY > window.innerHeight * 0.5);
    });
    btt.addEventListener('click', () => {
      if (warpJump) {
        warpJump.classList.add('active');
        setTimeout(() => {
          window.scrollTo({ top: 0, behavior: 'auto' });
          setTimeout(() => warpJump.classList.remove('active'), 300);
        }, 250);
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // ── 1. Typed text effect ──
  const typedEl = document.getElementById('typed-target');
  const cursorEl = document.getElementById('typed-cursor');
  if (typedEl) {
    const text = 'Two audiences.';
    let i = 0;
    function typeNext() {
      if (i < text.length) {
        typedEl.textContent += text[i];
        i++;
        setTimeout(typeNext, 70 + Math.random() * 40);
      } else if (cursorEl) {
        setTimeout(() => cursorEl.style.display = 'none', 2000);
      }
    }
    setTimeout(typeNext, 2000);
  }

  // ── 2. Counter animation ──
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = parseInt(el.dataset.target);
      if (el.dataset.counted) return;
      el.dataset.counted = '1';
      let n = 0;
      const step = Math.max(1, Math.floor(target / 30));
      const interval = setInterval(() => {
        n = Math.min(n + step, target);
        el.textContent = n;
        if (n >= target) clearInterval(interval);
      }, 40);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.counter').forEach(el => counterObserver.observe(el));

  // ── 3. 3D tilt on diagram ──
  const diagram = document.querySelector('.dual-diagram');
  if (diagram && !window.matchMedia('(max-width:700px)').matches) {
    diagram.addEventListener('mousemove', (e) => {
      const rect = diagram.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      diagram.style.transform = `perspective(800px) rotateY(${x * 6}deg) rotateX(${-y * 4}deg)`;
    });
    diagram.addEventListener('mouseleave', () => {
      diagram.style.transform = 'perspective(800px) rotateY(0) rotateX(0)';
    });
  }

  // ── 4. Nebula color shift on scroll — lila→gold ──
  const nebulas = document.querySelectorAll('.nebula');
  if (nebulas.length) {
    let nebTicking = false;
    window.addEventListener('scroll', () => {
      if (nebTicking) return;
      nebTicking = true;
      requestAnimationFrame(() => {
        const progress = Math.min(window.scrollY / (document.body.scrollHeight - window.innerHeight), 1);
        // Nebula 1 (top-left, purple): rotate towards warm, fade slightly
        nebulas[0].style.filter = 'blur(60px) hue-rotate(' + Math.round(progress * 90) + 'deg) brightness(' + (1 + progress * 0.5) + ')';
        // Nebula 2 (bottom-right, gold): grow brighter and more saturated
        nebulas[1].style.filter = 'blur(50px) saturate(' + (1 + progress * 2) + ') brightness(' + (1 + progress * 0.8) + ')';
        nebulas[1].style.opacity = 0.4 + progress * 0.8;
        // Nebula 3 (center, accent): shift hue + scale up
        nebulas[2].style.filter = 'blur(70px) hue-rotate(' + Math.round(progress * 120) + 'deg) brightness(' + (1 + progress * 0.3) + ')';
        nebulas[2].style.opacity = 0.5 + progress * 0.6;
        nebulas[2].style.transform = 'translate(' + (30 - progress * 60) + 'px, ' + (-25 + progress * 50) + 'px) scale(' + (1.1 + progress * 0.3) + ')';
        nebTicking = false;
      });
    });
  }
</script>

</body>
</html>
