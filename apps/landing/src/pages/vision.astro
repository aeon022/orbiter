---
import { ClientRouter } from 'astro:transitions';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Orbiter Vision — Dual Render &amp; the future of CMS</title>
  <meta name="description" content="One content source, two audiences. Orbiter is building Dual Render: structured content for humans and AI agents from a single POD file." />
  <link rel="canonical" href="https://orbiter.sh/vision" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content="Orbiter Vision — Dual Render &amp; the future of CMS" />
  <meta property="og:description" content="One content source, two audiences. Orbiter is building Dual Render: structured content for humans and AI agents from a single POD file." />
  <meta property="og:url"         content="https://orbiter.sh/vision" />
  <meta property="og:image"       content="https://orbiter.sh/og-card.png" />
  <meta property="og:image:alt"   content="Orbiter — CMS in one file for Astro" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name"   content="Orbiter" />
  <meta property="og:locale"      content="en_US" />

  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Orbiter Vision — Dual Render &amp; the future of CMS" />
  <meta name="twitter:description" content="One content source, two audiences. Orbiter is building Dual Render: structured content for humans and AI agents from a single POD file." />
  <meta name="twitter:image"       content="https://orbiter.sh/og-card.png" />
  <meta name="twitter:image:alt"   content="Orbiter — CMS in one file for Astro" />
  <meta name="twitter:site"        content="@gerwinweiher" />

  <!-- Icons & PWA -->
  <link rel="icon"     href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#8b7cf8" />

  <!-- Structured data -->
  <script type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Orbiter Vision — Dual Render & the future of CMS",
    "url": "https://orbiter.sh/vision",
    "description": "One content source, two audiences. Orbiter is building Dual Render: structured content for humans and AI agents from a single POD file.",
    "isPartOf": { "@type": "WebSite", "name": "Orbiter", "url": "https://orbiter.sh" },
    "publisher": { "@type": "Organization", "name": "Abteilung83", "url": "https://abteilung83.at" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Orbiter", "item": "https://orbiter.sh" },
        { "@type": "ListItem", "position": 2, "name": "Vision", "item": "https://orbiter.sh/vision" }
      ]
    }
  })}</script>

  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <ClientRouter />

  <style>
    @font-face {
      font-family: 'Inter';
      src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }

    :root {
      --bg: #08080f;
      --bg2: #0e0e1a;
      --text: #b8b8cc;
      --heading: #eeeef5;
      --accent: #8b7cf8;
      --accent2: #c4b9ff;
      --gold: #e6a817;
      --jade: #22c55e;
      --muted: #8585a8;
      --line: rgba(139,124,248,0.1);
      --glow: rgba(139,124,248,0.15);
    }

    * { margin:0; padding:0; box-sizing:border-box; }

    /* Decorative layers (planet glow etc.) are wider than a phone; clip them so the page doesn't widen and zoom out */
    html { overflow-x: clip; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* ── Background — deep space ── */
    .vision-bg {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: var(--bg);
    }

    /* ── Nav — compact, appears on scroll ── */
    .vision-nav {
      position: fixed; top: 16px; left: 50%; transform: translateX(-50%) translateY(-80px);
      width: auto; z-index: 200;
      display: flex; align-items: center; gap: 6px;
      padding: 8px 10px 8px 16px;
      background: rgba(7,7,15,0.88);
      backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
      border: 1px solid rgba(139,124,248,0.15);
      border-radius: 28px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.4);
      opacity: 0;
      transition: transform 0.4s ease, opacity 0.4s ease;
    }
    .vision-nav.visible {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    .vision-nav a { color: var(--muted); text-decoration: none; font-size: 11px; transition: color 0.15s; padding: 4px 10px; letter-spacing: 0.03em; }
    .vision-nav a:hover { color: var(--heading); }
    .vision-nav-logo { display: flex; align-items: center; gap: 6px; font-weight: 700; color: var(--heading); font-size: 11px; letter-spacing: 0.13em; text-transform: uppercase; padding: 0 8px 0 0; border-right: 1px solid var(--line); margin-right: 2px; }
    .vision-nav-logo svg { width: 18px; height: 18px; }
    .vision-nav-links { display: flex; gap: 2px; align-items: center; }
    .vision-nav-links .btn-sm { padding: 5px 14px; border: 1px solid rgba(139,124,248,0.3); color: var(--accent); border-radius: 16px; font-size: 10px; letter-spacing: 0.04em; transition: all 0.15s; }
    .vision-nav-links .btn-sm:hover { background: var(--accent); color: var(--bg); border-color: var(--accent); }

    /* ── Page load sequence ── */
    .page-curtain {
      position: fixed; inset: 0; z-index: 300;
      background: #000;
      pointer-events: none;
      animation: curtain-lift 1.2s ease 0.3s forwards;
    }
    @keyframes curtain-lift {
      0% { opacity: 1; }
      100% { opacity: 0; }
    }
    .planet-scene { animation: planet-rise 2s ease-out 0.5s forwards; }
    @keyframes planet-rise {
      from { transform: translateY(100px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    /* ── Planet horizon — view from station, scrolls away ── */
    .planet-scene {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      transition: none;
      will-change: transform, opacity;
    }
    .planet-wrap {
      position: absolute; bottom: -110vh; left: 50%; transform: translateX(-50%);
      width: 250vw; height: 160vh;
    }
    .planet-body {
      position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 250vw; height: 160vh;
      border-radius: 50%;
      background: radial-gradient(ellipse at 50% 8%, #151030 0%, #0c0a1a 30%, #060510 100%);
    }
    .planet-atmo {
      position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 250vw; height: 160vh;
      border-radius: 50%;
      box-shadow:
        0 -5px 150px 25px rgba(139,124,248,0.35),
        0 -3px 300px 80px rgba(139,124,248,0.15),
        0 0 500px 150px rgba(100,80,220,0.07);
      animation: atmo-breathe 8s ease-in-out infinite;
    }
    .planet-glow {
      position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 250vw; height: 160vh;
      border-radius: 50%;
      box-shadow:
        0 -1px 80px 15px rgba(196,185,255,0.5),
        0 -1px 30px 5px rgba(196,185,255,0.7),
        0 -1px 8px 2px rgba(230,225,255,0.8);
      animation: atmo-pulse 4s ease-in-out infinite;
    }
    .planet-glow-2 {
      position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 250vw; height: 160vh;
      border-radius: 50%;
      box-shadow:
        0 -2px 120px 30px rgba(139,124,248,0.25),
        0 -1px 60px 15px rgba(196,185,255,0.2);
      animation: atmo-pulse 3s ease-in-out infinite 1s;
    }
    .planet-glow-warm {
      position: absolute; bottom: 0; left: 40%; transform: translateX(-50%);
      width: 250vw; height: 160vh;
      border-radius: 50%;
      box-shadow:
        0 -2px 120px 20px rgba(230,168,23,0.12),
        0 -1px 60px 8px rgba(230,168,23,0.08);
      animation: atmo-pulse 7s ease-in-out infinite reverse;
    }
    /* Aurora wandering light on the horizon */
    .planet-aurora {
      position: absolute; bottom: calc(110vh + 5px); left: 0; right: 0; height: 40px;
      background: linear-gradient(90deg,
        transparent, rgba(139,124,248,0) 10%,
        rgba(100,200,255,0.08), rgba(139,124,248,0.12), rgba(180,120,255,0.1),
        rgba(230,168,23,0.06), rgba(139,124,248,0.1),
        rgba(139,124,248,0) 90%, transparent
      );
      background-size: 300% 100%;
      animation: aurora-drift 12s ease-in-out infinite alternate;
      filter: blur(8px);
    }
    .planet-aurora-2 {
      position: absolute; bottom: calc(110vh + 15px); left: 0; right: 0; height: 25px;
      background: linear-gradient(90deg,
        transparent, rgba(196,185,255,0) 15%,
        rgba(230,168,23,0.06), rgba(196,185,255,0.08), rgba(100,180,255,0.05),
        rgba(196,185,255,0) 85%, transparent
      );
      background-size: 250% 100%;
      animation: aurora-drift 8s ease-in-out infinite alternate-reverse;
      filter: blur(6px);
    }
    .planet-horizon-line {
      position: absolute; bottom: calc(110vh + 10px); left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg,
        transparent 2%,
        rgba(100,80,220,0.15) 12%,
        rgba(139,124,248,0.4) 30%,
        rgba(196,185,255,0.7) 45%,
        rgba(230,225,255,0.9) 50%,
        rgba(196,185,255,0.7) 55%,
        rgba(139,124,248,0.4) 70%,
        rgba(100,80,220,0.15) 88%,
        transparent 98%
      );
      animation: horizon-glow 6s ease-in-out infinite;
    }
    .planet-flare {
      position: absolute; bottom: calc(110vh + 10px); left: 50%; transform: translateX(-50%);
      width: 700px; height: 160px;
      background: radial-gradient(ellipse, rgba(196,185,255,0.25) 0%, rgba(139,124,248,0.1) 35%, transparent 70%);
      animation: flare-breathe 4s ease-in-out infinite;
    }
    .planet-flare-spot {
      position: absolute; bottom: calc(110vh + 20px); left: 35%;
      width: 200px; height: 80px;
      background: radial-gradient(ellipse, rgba(230,168,23,0.08) 0%, transparent 70%);
      animation: flare-wander 10s ease-in-out infinite alternate;
    }
    .planet-flare-spot-2 {
      position: absolute; bottom: calc(110vh + 15px); left: 60%;
      width: 150px; height: 60px;
      background: radial-gradient(ellipse, rgba(100,180,255,0.06) 0%, transparent 70%);
      animation: flare-wander 14s ease-in-out infinite alternate-reverse;
    }
    .planet-flare-wide {
      position: absolute; bottom: calc(110vh + 20px); left: 50%; transform: translateX(-50%);
      width: 100vw; height: 60px;
      background: linear-gradient(0deg, rgba(139,124,248,0.1), transparent);
    }
    @keyframes aurora-drift {
      from { background-position: 0% 0; }
      to { background-position: 100% 0; }
    }
    @keyframes horizon-glow {
      0%, 100% { opacity: 0.8; filter: brightness(1); }
      50% { opacity: 1; filter: brightness(1.3); }
    }
    @keyframes flare-wander {
      from { transform: translateX(0); opacity: 0.6; }
      to { transform: translateX(60px); opacity: 1; }
    }
    @keyframes atmo-breathe {
      0%, 100% { box-shadow: 0 -5px 150px 25px rgba(139,124,248,0.35), 0 -3px 300px 80px rgba(139,124,248,0.15), 0 0 500px 150px rgba(100,80,220,0.07); }
      50% { box-shadow: 0 -8px 180px 30px rgba(139,124,248,0.45), 0 -4px 350px 90px rgba(139,124,248,0.2), 0 0 550px 170px rgba(100,80,220,0.1); }
    }
    .planet-shimmer {
      position: absolute; bottom: calc(110vh + 8px); left: 0; right: 0; height: 8px;
      background: linear-gradient(90deg,
        transparent, rgba(196,185,255,0.0) 15%,
        rgba(196,185,255,0.2), rgba(220,210,255,0.5), rgba(230,225,255,0.6),
        rgba(220,210,255,0.5), rgba(196,185,255,0.2),
        rgba(196,185,255,0.0) 85%, transparent
      );
      background-size: 300% 100%;
      animation: shimmer-slide 6s linear infinite;
    }
    .planet-shimmer-2 {
      position: absolute; bottom: calc(110vh + 12px); left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg,
        transparent 10%, rgba(230,168,23,0.1) 30%, rgba(230,168,23,0.2) 50%,
        rgba(230,168,23,0.1) 70%, transparent 90%
      );
      background-size: 250% 100%;
      animation: shimmer-slide 10s linear infinite reverse;
    }


    /* Vertical light beam — grows on scroll */
    .light-beam {
      position: fixed; top: 0; left: 50%; transform: translateX(-50%);
      width: 1px; height: 0;
      background: linear-gradient(180deg, rgba(196,185,255,0.5), rgba(139,124,248,0.2), transparent);
      z-index: 0; pointer-events: none;
      will-change: height, opacity;
      box-shadow: 0 0 15px 3px rgba(139,124,248,0.08), 0 0 40px 8px rgba(139,124,248,0.04);
    }
    .light-beam-glow {
      position: fixed; top: 0; left: 50%; transform: translateX(-50%);
      width: 120px; height: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(139,124,248,0.06) 0%, transparent 70%);
      z-index: 0; pointer-events: none;
      will-change: height, opacity;
    }

    /* Canvas starfield */
    #starfield {
      position: fixed; inset: 0; z-index: 0;
      pointer-events: none;
    }

    /* Nebulas — drifting color blobs */
    .nebula {
      position: fixed; border-radius: 50%;
      pointer-events: none; z-index: 0;
    }
    .nebula-1 {
      width: 900px; height: 900px; top: -300px; left: -300px;
      background: radial-gradient(circle, rgba(108,92,231,0.18) 0%, transparent 65%);
      filter: blur(60px);
      animation: neb-drift-1 25s ease-in-out infinite alternate;
    }
    .nebula-2 {
      width: 700px; height: 700px; bottom: 10%; right: -250px;
      background: radial-gradient(circle, rgba(230,168,23,0.12) 0%, transparent 65%);
      filter: blur(50px); opacity: 0.4;
      animation: neb-drift-2 30s ease-in-out infinite alternate;
    }
    .nebula-3 {
      width: 600px; height: 600px; top: 45%; left: 35%;
      background: radial-gradient(circle, rgba(139,124,248,0.1) 0%, transparent 65%);
      filter: blur(70px); opacity: 0.5;
      animation: neb-drift-3 20s ease-in-out infinite alternate;
    }
    .nebula { transition: filter 0.5s ease; }
    @keyframes neb-drift-1 { from { transform: translate(0,0) scale(1); } to { transform: translate(50px,30px) scale(1.12); } }
    @keyframes neb-drift-2 { from { transform: translate(0,0) scale(1); } to { transform: translate(-40px,-20px) scale(1.08); } }
    @keyframes neb-drift-3 { from { transform: translate(0,0) scale(1); } to { transform: translate(30px,-25px) scale(1.1); } }

    @keyframes atmo-pulse {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }
    @keyframes flare-breathe {
      0%, 100% { opacity: 0.6; transform: translateX(-50%) scaleX(1); }
      50% { opacity: 1; transform: translateX(-50%) scaleX(1.15); }
    }
    @keyframes shimmer-slide {
      from { background-position: 200% 0; }
      to { background-position: -200% 0; }
    }

    /* ── Sections ── */
    .vision-section {
      position: relative; z-index: 1;
      max-width: 900px; margin: 0 auto;
      padding: 0 32px;
    }

    /* ── Hero ── */
    .vision-hero {
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center;
      padding-top: 80px;
      position: relative; overflow: hidden;
    }
    .vision-eyebrow {
      font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 24px;
      opacity: 0; animation: fadeUp 0.8s 1.2s forwards;
      position: relative; z-index: 2;
    }
    .vision-h1 {
      font-size: clamp(36px, 6vw, 64px);
      font-weight: 300; color: var(--heading);
      line-height: 1.15; margin-bottom: 24px;
      opacity: 0; animation: fadeUp 1s 1.5s forwards;
      position: relative; z-index: 2;
    }
    .vision-h1 em {
      font-style: normal;
      background: linear-gradient(135deg, var(--accent), var(--gold));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    /* Typed cursor */
    .typed-cursor {
      display: inline-block; width: 2px; height: 0.9em;
      background: var(--accent); margin-left: 2px;
      vertical-align: text-bottom;
      animation: cursor-blink 0.8s step-end infinite;
    }
    @keyframes cursor-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* Counter */
    .counter { display: inline; }

    /* 3D tilt on diagram */
    .dual-diagram {
      transition: transform 0.15s ease;
      transform-style: preserve-3d; perspective: 800px;
    }
    .vision-sub {
      font-size: 18px; color: var(--text); max-width: 600px;
      margin-bottom: 48px;
      opacity: 0; animation: fadeUp 0.8s 2s forwards;
      position: relative; z-index: 2;
    }
    .vision-scroll-hint {
      font-size: 11px; color: var(--muted); letter-spacing: 0.15em;
      opacity: 0; animation: fadeUp 0.8s 2.6s forwards;
      position: relative; z-index: 2;
    }
    .vision-scroll-hint span {
      display: inline-block; animation: bounce 2s infinite;
    }

    /* ── Dual Render Block ── */
    .dual-section { padding: 120px 32px; max-width: 1000px; margin: 0 auto; position: relative; z-index: 1; }

    .dual-label {
      font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 12px;
    }
    .dual-h2 {
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 300; color: var(--heading);
      line-height: 1.2; margin-bottom: 20px;
    }
    .dual-body { font-size: 16px; color: var(--text); max-width: 640px; margin-bottom: 48px; }

    /* Diagram */
    .dual-diagram {
      display: grid; grid-template-columns: 1fr auto 1fr; gap: 0; align-items: stretch;
      border: 1px solid var(--line); border-radius: 16px;
      overflow: hidden; margin-bottom: 64px;
      background: rgba(14,14,26,0.6);
      backdrop-filter: blur(12px);
    }
    .dual-col {
      padding: 32px 28px;
    }
    .dual-col-center {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 32px 20px; border-left: 1px solid var(--line); border-right: 1px solid var(--line);
      background: rgba(139,124,248,0.04);
    }
    .dual-col-label {
      font-size: 9px; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 16px;
    }
    .dual-col-icon { font-size: 28px; margin-bottom: 12px; opacity: 0.7; }
    .dual-col-title { font-size: 15px; font-weight: 600; color: var(--heading); margin-bottom: 8px; }
    .dual-col-items { list-style: none; font-size: 13px; color: var(--text); }
    .dual-col-items li { padding: 4px 0; display: flex; align-items: center; gap: 8px; }
    .dual-col-items li::before { content: '→'; color: var(--accent); font-size: 11px; flex-shrink: 0; }
    .dual-col-center .dual-col-items li::before { content: '◈'; }
    .dual-arrow { color: var(--accent); font-size: 20px; margin: 8px 0; }

    /* Flow */
    .dual-flow {
      display: flex; align-items: center; justify-content: center; gap: 16px;
      margin-bottom: 64px; flex-wrap: wrap;
    }
    .flow-node {
      padding: 10px 20px; border: 1px solid var(--line); border-radius: 8px;
      font-size: 13px; color: var(--heading); background: var(--bg2);
      text-align: center; min-width: 120px;
    }
    .flow-node.accent { border-color: var(--accent); background: rgba(139,124,248,0.08); }
    .flow-node.gold { border-color: var(--gold); background: rgba(230,168,23,0.06); color: var(--gold); }
    .flow-arrow { color: var(--muted); font-size: 18px; }

    /* ── Research Platform ── */
    .research-section { padding: 120px 32px; max-width: 1000px; margin: 0 auto; position: relative; z-index: 1; }

    .depth-model {
      display: grid; grid-template-columns: 1fr; gap: 0;
      border: 1px solid var(--line); border-radius: 16px;
      overflow: hidden; margin: 48px 0 64px;
      background: rgba(14,14,26,0.6);
      backdrop-filter: blur(12px);
    }
    .depth-row {
      display: grid; grid-template-columns: 80px 1fr 1fr;
      border-bottom: 1px solid var(--line);
      transition: background 0.2s;
    }
    .depth-row:last-child { border-bottom: none; }
    .depth-row:hover { background: rgba(139,124,248,0.04); }
    .depth-num {
      padding: 20px 16px;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; font-weight: 600;
      border-right: 1px solid var(--line);
    }
    .depth-num.d0 { color: var(--jade); }
    .depth-num.d1 { color: var(--accent); }
    .depth-num.d2 { color: var(--gold); }
    .depth-num.d3 { color: var(--muted); }
    .depth-info {
      padding: 20px 24px;
      border-right: 1px solid var(--line);
    }
    .depth-label { font-size: 14px; font-weight: 600; color: var(--heading); margin-bottom: 4px; }
    .depth-desc { font-size: 12px; color: var(--text); line-height: 1.5; }
    .depth-audience {
      padding: 20px 24px;
      display: flex; align-items: center;
      font-size: 12px; color: var(--muted);
    }

    .research-features {
      display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
      margin-top: 48px;
    }
    .research-card {
      padding: 28px;
      border: 1px solid var(--line); border-radius: 12px;
      background: rgba(14,14,26,0.5);
      backdrop-filter: blur(8px);
    }
    .research-card-icon { font-size: 22px; margin-bottom: 12px; opacity: 0.7; }
    .research-card-title { font-size: 15px; font-weight: 600; color: var(--heading); margin-bottom: 8px; }
    .research-card-desc { font-size: 13px; color: var(--text); line-height: 1.6; }

    @media (max-width: 700px) {
      .research-section { padding: 60px 16px; }
      .depth-row { grid-template-columns: 50px 1fr; }
      .depth-audience { display: none; }
      .research-features { grid-template-columns: 1fr; }
    }

    /* ── Roadmap ── */
    .roadmap-section { padding: 120px 32px; max-width: 900px; margin: 0 auto; position: relative; z-index: 1; }

    .roadmap-track { position: relative; padding-left: 40px; }
    .roadmap-track::before {
      content: ''; position: absolute; left: 12px; top: 0; bottom: 0;
      width: 1px; background: linear-gradient(to bottom, var(--accent), var(--gold), var(--muted));
    }

    /* Sci-fi scan light that follows scroll through the timeline */
    .roadmap-glow {
      position: absolute; left: -60px; width: calc(100% + 120px);
      height: 200px; pointer-events: none;
      background: radial-gradient(ellipse at 50% 50%,
        rgba(139,124,248,0.12) 0%,
        rgba(139,124,248,0.05) 30%,
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
      will-change: top;
    }
    .roadmap-glow.active { opacity: 1; }
    .roadmap-glow::before {
      content: ''; position: absolute; left: 60px; top: 50%;
      width: 3px; height: 60px; transform: translateY(-50%);
      background: linear-gradient(180deg, transparent, var(--accent), transparent);
      border-radius: 2px;
      box-shadow: 0 0 20px 4px rgba(139,124,248,0.3), 0 0 60px 10px rgba(139,124,248,0.1);
    }
    .roadmap-glow::after {
      content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px;
      background: linear-gradient(90deg,
        transparent 5%,
        rgba(139,124,248,0.08) 20%,
        rgba(139,124,248,0.15) 50%,
        rgba(139,124,248,0.08) 80%,
        transparent 95%
      );
    }

    /* Energized timeline line — glows when items are visible */
    .roadmap-track-energy {
      position: absolute; left: 11px; top: 0; width: 3px; height: 0;
      background: linear-gradient(180deg, var(--jade), var(--accent));
      border-radius: 2px;
      box-shadow: 0 0 8px rgba(139,124,248,0.3), 0 0 20px rgba(139,124,248,0.1);
      transition: height 0.6s cubic-bezier(0.16,1,0.3,1);
    }

    .rm-item { position: relative; margin-bottom: 48px; }
    .rm-dot {
      position: absolute; left: -40px; top: 4px;
      width: 24px; height: 24px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; border: 2px solid var(--line);
      background: var(--bg);
    }
    .rm-dot.done { border-color: var(--jade); color: var(--jade); }
    .rm-dot.next { border-color: var(--accent); color: var(--accent); background: rgba(139,124,248,0.1); box-shadow: 0 0 12px var(--glow); }
    .rm-dot.future { border-color: var(--muted); color: var(--muted); }
    .rm-phase {
      font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 4px;
    }
    .rm-title { font-size: 18px; font-weight: 500; color: var(--heading); margin-bottom: 6px; }
    .rm-desc { font-size: 13px; color: var(--text); line-height: 1.6; }
    .rm-tag {
      display: inline-block; font-size: 9px; padding: 2px 8px; margin-top: 8px;
      border-radius: 3px; letter-spacing: 0.06em;
    }
    .rm-tag.done { color: var(--jade); background: rgba(34,197,94,0.1); }
    .rm-tag.next { color: var(--accent); background: rgba(139,124,248,0.1); }
    .rm-tag.future { color: var(--muted); background: rgba(85,85,112,0.15); }


    /* ── Roadmap: readable links, filter bar, progress ── */
    .rm-desc a { color: var(--accent); text-decoration: underline; text-decoration-color: rgba(139,124,248,0.4); text-underline-offset: 3px; }
    .rm-desc a:hover { color: #b6adff; text-decoration-color: currentColor; }
    .rm-desc code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11.5px; background: rgba(139,124,248,0.1); padding: 1px 5px; border-radius: 4px; }
    .rm-title { display: flex; align-items: baseline; gap: 8px; }
    /* the # links are created by JS, so they don't carry Astro's scope attribute → :global */
    :global(.rm-anchor) { opacity: 0; font-size: 13px; color: var(--muted); text-decoration: none; transition: opacity .15s, color .15s; }
    .rm-item:hover :global(.rm-anchor), :global(.rm-anchor:focus-visible) { opacity: 1; }
    :global(.rm-anchor:hover) { color: var(--accent); }
    .rm-item[hidden] { display: none; }
    .rm-item:target .rm-title { color: var(--accent); }

    .rm-controls { max-width: 780px; margin: 40px auto 0; padding: 0 24px; display: flex; flex-direction: column; gap: 14px; }
    .rm-progress { display: flex; align-items: center; gap: 12px; font-size: 11px; color: var(--muted); letter-spacing: .04em; }
    .rm-progress-bar { flex: 1; height: 4px; border-radius: 4px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .rm-progress-fill { height: 100%; width: 0; border-radius: 4px; background: linear-gradient(90deg, var(--jade), var(--accent)); transition: width 1.2s cubic-bezier(.16,1,.3,1); }
    .rm-filter { display: flex; gap: 8px; flex-wrap: wrap; }
    .rm-chip { font: inherit; font-size: 11px; letter-spacing: .04em; color: var(--muted); background: transparent; border: 1px solid rgba(139,124,248,0.2); border-radius: 16px; padding: 6px 14px; cursor: pointer; transition: all .15s; }
    .rm-chip:hover { color: var(--heading); border-color: rgba(139,124,248,0.45); }
    .rm-chip[aria-pressed="true"] { color: var(--accent); background: rgba(139,124,248,0.14); border-color: rgba(139,124,248,0.5); }
    .rm-chip .n { opacity: 1; color: #9a9ab8; margin-left: 4px; font-variant-numeric: tabular-nums; }
    :global(.rm-weigh) { display: inline-block; margin: 8px 0 0 10px; font-size: 11px; color: var(--muted); text-decoration: none; border-bottom: 1px dashed rgba(139,124,248,0.35); transition: color .15s, border-color .15s; }
    :global(.rm-weigh:hover) { color: var(--accent); border-bottom-color: var(--accent); }
    .rm-suggest { text-decoration: none; display: inline-flex; align-items: center; }
    .rm-machine { margin-left: auto; color: var(--accent); border-style: dashed; }
    /* the page-wide `* { margin: 0 }` reset also removes a modal dialog's auto margins → centre it explicitly */
    .mv-dialog { margin: auto; width: min(760px, calc(100vw - 32px)); max-height: 80vh; padding: 0; border: 1px solid rgba(139,124,248,0.35); border-radius: 18px; background: rgba(9,9,20,0.96); color: var(--text); box-shadow: 0 24px 80px rgba(0,0,0,0.6); }
    .mv-dialog::backdrop { background: rgba(3,3,10,0.7); backdrop-filter: blur(4px); }
    .mv-head { display: flex; gap: 16px; align-items: flex-start; justify-content: space-between; padding: 18px 20px 12px; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .mv-title { font-size: 15px; font-weight: 600; color: var(--heading); }
    .mv-sub { font-size: 11.5px; color: var(--muted); margin-top: 3px; line-height: 1.5; }
    .mv-actions { display: flex; gap: 6px; flex-shrink: 0; }
    .mv-pre { margin: 0; padding: 16px 20px 20px; max-height: calc(80vh - 90px); overflow: auto; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11.5px; line-height: 1.6; color: #b9b9d6; white-space: pre-wrap; overflow-wrap: anywhere; }
    .rm-chip:focus-visible, :global(.rm-anchor:focus-visible), .hz-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

    /* ── Horizon: the next three bets ── */
    .horizon-section { max-width: 1040px; margin: 72px auto 0; padding: 0 24px; }
    .horizon-section .dual-label { text-align: center; }
    .horizon { margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .hz-card { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 20px 20px 18px; border-radius: 18px; text-decoration: none; color: inherit; overflow: hidden;
      background: linear-gradient(160deg, rgba(139,124,248,0.07), rgba(255,255,255,0.02)); border: 1px solid rgba(139,124,248,0.16); transition: transform .25s ease, border-color .25s ease; }
    .hz-card::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .25s;
      background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), rgba(139,124,248,0.18), transparent 70%); }
    .hz-card:hover { transform: translateY(-3px); border-color: rgba(139,124,248,0.4); }
    .hz-card:hover::before { opacity: 1; }
    .hz-eyebrow { font-size: 9px; letter-spacing: .25em; text-transform: uppercase; color: var(--accent); }
    .hz-title { font-size: 17px; font-weight: 500; color: var(--heading); line-height: 1.3; }
    .hz-text { font-size: 12.5px; color: var(--text); line-height: 1.55; opacity: .9; }
    .hz-more { margin-top: auto; padding-top: 6px; font-size: 11px; color: var(--muted); letter-spacing: .04em; }
    .hz-card:hover .hz-more { color: var(--accent); }
    .hz-viz { height: 96px; border-radius: 12px; background: rgba(5,5,12,0.55); border: 1px solid rgba(255,255,255,0.05); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    /* proposals: a diff that gets accepted */
    .hz-diff { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 10.5px; line-height: 1.7; width: 86%; }
    .hz-diff .del { color: #f0788c; background: rgba(240,120,140,0.1); border-radius: 3px; padding: 0 6px; display: block; animation: hz-del 6s ease-in-out infinite; }
    .hz-diff .add { color: #4ade80; background: rgba(74,222,128,0.1); border-radius: 3px; padding: 0 6px; display: block; animation: hz-add 6s ease-in-out infinite; }
    .hz-accept { position: absolute; right: 10px; bottom: 8px; font-size: 9px; letter-spacing: .08em; color: #07070f; background: var(--accent); border-radius: 10px; padding: 2px 9px; animation: hz-pulse 6s ease-in-out infinite; }
    .hz-agent { position: absolute; left: 10px; top: 7px; font-size: 8.5px; letter-spacing: .08em; color: var(--muted); }
    @keyframes hz-del { 0%,45% { opacity: 1; text-decoration: none; } 60%,100% { opacity: .35; text-decoration: line-through; } }
    @keyframes hz-add { 0%,20% { opacity: .25; } 40%,100% { opacity: 1; } }
    @keyframes hz-pulse { 0%,38% { transform: scale(1); box-shadow: 0 0 0 0 rgba(139,124,248,0); } 48% { transform: scale(1.08); box-shadow: 0 0 0 6px rgba(139,124,248,0.25); } 60%,100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(139,124,248,0); } }
    /* semantic search: a query ring finds its neighbours */
    .hz-dots { width: 100%; height: 100%; }
    .hz-dots circle { fill: rgba(150,150,190,0.5); }
    .hz-dots .hit { animation: hz-hit 5s ease-in-out infinite; }
    .hz-dots .ring { fill: none; stroke: var(--accent); stroke-width: 1; transform-origin: 50% 50%; animation: hz-ring 5s ease-out infinite; }
    @keyframes hz-ring { 0% { transform: scale(.2); opacity: .9; } 70%,100% { transform: scale(1); opacity: 0; } }
    @keyframes hz-hit { 0%,25% { fill: rgba(150,150,190,0.5); } 45%,85% { fill: #4ade80; } 100% { fill: rgba(150,150,190,0.5); } }
    /* verifiable: a hash chain with a seal */
    .hz-chain { display: flex; align-items: center; gap: 0; }
    .hz-block { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 8.5px; color: var(--muted); border: 1px solid rgba(139,124,248,0.3); border-radius: 6px; padding: 5px 7px; background: rgba(139,124,248,0.06); animation: hz-glow 4.5s ease-in-out infinite; }
    .hz-block:nth-child(3) { animation-delay: .6s; } .hz-block:nth-child(5) { animation-delay: 1.2s; }
    .hz-link { width: 14px; height: 1px; background: rgba(139,124,248,0.5); }
    .hz-seal { position: absolute; right: 10px; top: 8px; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid #4ade80; color: #4ade80; font-size: 10px; display: flex; align-items: center; justify-content: center; animation: hz-seal 4.5s ease-in-out infinite; }
    @keyframes hz-glow { 0%,100% { border-color: rgba(139,124,248,0.3); color: var(--muted); } 35% { border-color: var(--accent); color: var(--heading); } }
    @keyframes hz-seal { 0%,55% { opacity: .2; transform: scale(.8); } 70%,100% { opacity: 1; transform: scale(1); } }
    @media (max-width: 860px) { .horizon { grid-template-columns: 1fr; max-width: 520px; } }
    @media (prefers-reduced-motion: reduce) {
      .hz-diff .del, .hz-diff .add, .hz-accept, .hz-dots .hit, .hz-dots .ring, .hz-block, .hz-seal { animation: none; }
      .hz-diff .del { text-decoration: line-through; opacity: .5; } .hz-dots .hit { fill: #4ade80; } .hz-dots .ring { opacity: .3; transform: none; }
      .rm-progress-fill { transition: none; } .hz-card, .hz-card::before { transition: none; }
    }

    /* ── Hero back link ── */
    .hud-back {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 10px; font-family: 'Inter', sans-serif;
      letter-spacing: 0.08em; color: var(--muted);
      text-decoration: none;
      margin-bottom: 20px;
      opacity: 0; animation: fadeUp 0.6s 0.8s forwards;
      position: relative; z-index: 2;
      transition: color 0.2s;
    }
    .hud-back:hover { color: var(--accent); }
    .hud-back::before { content: '←'; font-size: 13px; }

    /* ── Back to top — warp jump ── */
    .btt {
      position: fixed; bottom: 28px; right: 28px; z-index: 150;
      width: 48px; height: 48px;
      border-radius: 50%;
      background: rgba(7,7,15,0.8);
      backdrop-filter: blur(16px);
      border: none;
      color: var(--accent);
      font-size: 16px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      opacity: 0; transform: translateY(20px) scale(0.8);
      transition: opacity 0.3s, transform 0.3s;
      pointer-events: none;
      overflow: visible;
    }
    .btt.visible { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }
    .btt::before {
      content: '';
      position: absolute; inset: -2px; border-radius: 50%;
      padding: 2px;
      background: conic-gradient(from var(--btt-angle, 0deg),
        transparent 20%, rgba(139,124,248,0.2) 30%,
        rgba(196,185,255,0.7) 50%,
        rgba(139,124,248,0.2) 70%, transparent 80%
      );
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      animation: btt-spin 2.5s linear infinite;
    }
    .btt::after {
      content: '';
      position: absolute; inset: -8px; border-radius: 50%;
      border: 1px solid rgba(139,124,248,0.1);
      animation: btt-ring 2s ease-in-out infinite;
    }
    .btt:hover {
      color: #fff;
      box-shadow: 0 0 30px rgba(139,124,248,0.3), 0 0 60px rgba(139,124,248,0.1);
    }
    .btt:hover::after {
      border-color: rgba(139,124,248,0.3);
      box-shadow: 0 0 20px rgba(139,124,248,0.15);
    }
    @property --btt-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
    @keyframes btt-spin { to { --btt-angle: 360deg; } }
    @keyframes btt-ring {
      0%, 100% { transform: scale(1); opacity: 0.4; }
      50% { transform: scale(1.2); opacity: 0; }
    }

    /* Warp jump overlay */
    .warp-jump {
      position: fixed; inset: 0; z-index: 9999;
      pointer-events: none; opacity: 0;
    }
    .warp-jump.active { animation: warp-jump-anim 0.7s ease-out forwards; }
    .warp-jump-streaks {
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent 0%, transparent 46%,
        rgba(196,185,255,0.2) 48%,
        rgba(196,185,255,0.4) 50%,
        rgba(196,185,255,0.2) 52%,
        transparent 54%, transparent 100%
      );
      background-size: 100% 20px;
    }
    .warp-jump-flash {
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(139,124,248,0.4) 0%, transparent 60%);
    }
    @keyframes warp-jump-anim {
      0% { opacity: 0; }
      15% { opacity: 1; }
      40% { opacity: 1; }
      100% { opacity: 0; }
    }

    /* ── CTA ── */
    .vision-cta {
      text-align: center; padding: 120px 32px 80px;
      position: relative; z-index: 1;
    }
    .vision-cta h2 { font-size: 32px; font-weight: 300; color: var(--heading); margin-bottom: 16px; }
    .vision-cta p { color: var(--text); margin-bottom: 32px; }
    .vision-cta-links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .vision-cta-links a {
      padding: 12px 28px; border-radius: 24px; font-size: 14px;
      text-decoration: none; transition: all 0.15s;
    }
    .btn-primary { background: var(--accent); color: #fff; border: 1px solid var(--accent); }
    .btn-primary:hover { background: var(--accent2); border-color: var(--accent2); color: var(--bg); }
    .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

    /* ── Warp Footer ── */
    .warp-footer {
      position: relative; z-index: 1;
      overflow: hidden;
      margin-top: 40px;
    }
    .warp-scene {
      position: relative; min-height: 480px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: flex-end;
      padding-bottom: 40px;
    }
    .warp-nebula {
      position: absolute; bottom: -70%; left: 50%; transform: translateX(-50%);
      width: 200vw; height: 100%;
      border-radius: 50%;
      background: radial-gradient(ellipse at 50% 85%, #18122e 0%, #0c0a1a 50%, transparent 100%);
    }
    .warp-corona {
      position: absolute; bottom: -70%; left: 50%; transform: translateX(-50%);
      width: 200vw; height: 100%;
      border-radius: 50%;
      box-shadow:
        0 -3px 120px 20px rgba(230,168,23,0.18),
        0 -2px 60px 8px rgba(255,200,80,0.25),
        0 -1px 20px 3px rgba(255,210,100,0.35);
      animation: warp-pulse 6s ease-in-out infinite;
    }
    .warp-corona-accent {
      position: absolute; bottom: -70%; left: 50%; transform: translateX(-50%);
      width: 200vw; height: 100%;
      border-radius: 50%;
      box-shadow:
        0 -2px 100px 15px rgba(139,124,248,0.1),
        0 -1px 40px 6px rgba(139,124,248,0.06);
      animation: warp-pulse 4s ease-in-out infinite 1.5s;
    }
    .warp-line {
      position: absolute; bottom: 50%; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg,
        transparent 5%,
        rgba(230,168,23,0.08) 20%,
        rgba(230,168,23,0.25) 40%,
        rgba(255,200,80,0.5) 50%,
        rgba(230,168,23,0.25) 60%,
        rgba(230,168,23,0.08) 80%,
        transparent 95%
      );
    }
    .warp-shimmer {
      position: absolute; bottom: calc(50% - 3px); left: 0; right: 0; height: 6px;
      background: linear-gradient(90deg,
        transparent, rgba(255,200,80,0.0) 20%,
        rgba(255,200,80,0.12), rgba(255,220,120,0.25),
        rgba(255,200,80,0.12), rgba(255,200,80,0.0) 80%, transparent
      );
      background-size: 300% 100%;
      animation: shimmer-slide 7s linear infinite;
    }
    .warp-flare {
      position: absolute; bottom: calc(50% - 50px); left: 50%; transform: translateX(-50%);
      width: 400px; height: 100px;
      background: radial-gradient(ellipse, rgba(255,200,80,0.1) 0%, transparent 70%);
      animation: warp-pulse 5s ease-in-out infinite 0.5s;
    }

    .warp-content {
      position: relative; z-index: 2;
      text-align: center; padding: 0 32px;
    }
    .warp-quote {
      font-size: 15px; font-style: italic; color: var(--muted);
      max-width: 460px; margin: 0 auto 8px;
      line-height: 1.7;
    }
    .warp-quote em { font-style: normal; color: var(--heading); }
    .warp-attr {
      font-size: 10px; color: var(--muted); letter-spacing: 0.1em;
      margin-bottom: 32px;
    }
    .warp-links {
      display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .warp-links a {
      color: var(--muted); text-decoration: none; font-size: 11px;
      letter-spacing: 0.06em; transition: color 0.15s;
    }
    .warp-links a:hover { color: var(--accent); }
    .warp-copy {
      font-size: 10px; color: rgba(85,85,112,0.5);
    }
    .warp-copy a { color: rgba(139,124,248,0.4); text-decoration: none; }
    .warp-copy a:hover { color: var(--accent); }

    @keyframes warp-pulse {
      0%, 100% { opacity: 0.6; }
      50% { opacity: 1; }
    }

    /* ── Animations ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(5px); }
    }

    .reveal {
      opacity: 0; transform: translateY(30px);
      transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-d1 { transition-delay: 0.12s; }
    .reveal-d2 { transition-delay: 0.24s; }
    .reveal-d3 { transition-delay: 0.36s; }
    .reveal-d4 { transition-delay: 0.48s; }

    /* Slide from left/right */
    .reveal-left { opacity: 0; transform: translateX(-40px); transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
    .reveal-right { opacity: 0; transform: translateX(40px); transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
    .reveal-left.visible, .reveal-right.visible { opacity: 1; transform: translateX(0); }

    /* Scale in */
    .reveal-scale { opacity: 0; transform: scale(0.92); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16,1,0.3,1); }
    .reveal-scale.visible { opacity: 1; transform: scale(1); }

    /* Roadmap dot glow-up on scroll */
    .rm-dot { transition: box-shadow 0.5s ease, border-color 0.5s ease, transform 0.3s ease; }
    .rm-item.visible .rm-dot.done { box-shadow: 0 0 12px rgba(34,197,94,0.3); transform: scale(1.1); }
    .rm-item.visible .rm-dot.next { box-shadow: 0 0 16px var(--glow); transform: scale(1.15); }
    .rm-item.visible .rm-dot.future { box-shadow: 0 0 8px rgba(85,85,112,0.2); }

    /* ── Responsive ── */
